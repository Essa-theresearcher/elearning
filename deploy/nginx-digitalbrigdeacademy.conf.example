# Install on the VPS (Ubuntu + nginx):
#   sudo cp deploy/nginx-digitalbrigdeacademy.conf.example /etc/nginx/sites-available/learning-ms
#   sudo ln -sf /etc/nginx/sites-available/learning-ms /etc/nginx/sites-enabled/learning-ms
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow 443/tcp
#   sudo certbot --nginx -d digitalbrigdeacademy.com -d www.digitalbrigdeacademy.com
#
# The Learning MS app must be running (systemd learning-ms on port 8765).

server {
    listen 80;
    listen [::]:80;
    server_name digitalbrigdeacademy.com www.digitalbrigdeacademy.com;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        client_max_body_size 512m;
    }
}
