# Local default is SQLite. Production uses PostgreSQL when DATABASE_URL is set.

# Production PostgreSQL connection string.
# Replace the username, password, host, port, and database name.
DATABASE_URL=postgresql://learning_user:change_me@db.example.com:5432/learning_ms

# Web server binding.
APP_HOST=0.0.0.0
PORT=8765

# Set this to 1 when serving over HTTPS in production.
COOKIE_SECURE=1

# Login/session settings.
AUTH_COOKIE_NAME=dba_session
REQUIRE_LOGIN=1
ALLOW_SIGNUP=0
SESSION_DAYS=30

# Admin account. Use a private password that teachers and students do not know.
SYSTEM_ADMIN_USERNAME=admin
SYSTEM_ADMIN_PASSWORD=change_this_admin_password
SYSTEM_ADMIN_DISPLAY_NAME=Admin

# Teacher account. The local default teacher password is changeme123.
TEACHER_USERNAME=teacher
TEACHER_PASSWORD=changeme123
TEACHER_DISPLAY_NAME=Teacher

# First student account, only for local testing unless you want a default student.
STUDENT_USERNAME=student
STUDENT_PASSWORD=change_this_student_password
STUDENT_DISPLAY_NAME=Student

# Comma-separated student usernames that should bypass checkout approval.
DIRECT_ACCESS_STUDENT_USERNAMES=zakariya

# Optional app defaults.
COOKIE_NAME=dba_student_id
LESSON_SLUG=cs-fundamentals-lesson-1
LESSON1_VIDEO_DIR=assets/videos/lesson1
LESSON2_VIDEO_DIR=assets/videos/lesson2

# Local SQLite fallback only. Ignored when DATABASE_URL is set.
SQLITE_DB_PATH=data/learning_ms.sqlite3
