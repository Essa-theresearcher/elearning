# Local default is SQLite. Production uses PostgreSQL when DATABASE_URL is set.

# Production PostgreSQL connection string.
# Replace the username, password, host, port, and database name.
DATABASE_URL=postgresql://learning_user:change_me@db.example.com:5432/learning_ms

# Web server binding.
APP_HOST=0.0.0.0
PORT=8765

# Set this to 1 when serving over HTTPS in production.
COOKIE_SECURE=1

# Login/session settings.
AUTH_COOKIE_NAME=dba_session
REQUIRE_LOGIN=1
ALLOW_SIGNUP=0
SESSION_DAYS=30

# First teacher account. Change ADMIN_PASSWORD before production.
ADMIN_USERNAME=teacher
ADMIN_PASSWORD=change_this_teacher_password
ADMIN_DISPLAY_NAME=Teacher

# Optional app defaults.
COOKIE_NAME=dba_student_id
LESSON_SLUG=cs-fundamentals-lesson-1
LESSON1_VIDEO_DIR=assets/videos/lesson1
LESSON2_VIDEO_DIR=assets/videos/lesson2

# Local SQLite fallback only. Ignored when DATABASE_URL is set.
SQLITE_DB_PATH=data/learning_ms.sqlite3
